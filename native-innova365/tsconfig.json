{
  "compilerOptions": {
    "allowJs": true, "checkJs": true, "noEmit": true, "strict": false, "noImplicitAny": false,
    "target": "ES2022", "module": "commonjs", "lib": ["ES2022", "DOM"],
    "types": ["node"], "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true
  },
  "include": ["src/**/*.js", "lib/**/*.js"]
}
